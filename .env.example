NODE_ENV=production
HOST=127.0.0.1
PORT=3100
APP_BASE_URL=https://learn.example.com
APP_SECRET=replace-with-at-least-32-random-characters
ADMIN_TOKEN=replace-with-a-long-random-admin-token
DEFAULT_TIMEZONE=Europe/Brussels
DEFAULT_LANGUAGE=ar
DATA_DIR=./data
LOG_LEVEL=info

# AI: chatgpt_business | mock | openai_compatible | ollama
AI_PROVIDER=chatgpt_business
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# ChatGPT Business custom GPT Action workflow
GPT_ACTIONS_ENABLED=true
GPT_ACTION_API_KEY=replace-with-a-long-random-action-api-key
GPT_AUTO_SCHEDULE_APPROVED=true
GPT_AUTO_SCHEDULE_DELAY_MINUTES=2
GPT_TASK_CLAIM_TIMEOUT_MINUTES=30
GPT_NOTIFY_PENDING_TASKS=true
CUSTOM_GPT_URL=

# Learner automation defaults
AUTO_START_FIRST_PLAN=true
NOTIFY_ACTION_REQUIRED=true
UNFINISHED_ITEM_LIMIT=3

# Optional free/self-hosted web search. Example: http://127.0.0.1:8080
SEARXNG_URL=
RESEARCH_MAX_RESULTS=12
RESEARCH_FETCH_TIMEOUT_MS=12000

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# WhatsApp Web via Baileys (unofficial, no per-message fee)
WHATSAPP_ENABLED=false
WHATSAPP_AUTH_DIR=./data/whatsapp-auth
WHATSAPP_DEDICATED_NUMBER=
WHATSAPP_MIN_SEND_INTERVAL_MS=2500

# Scheduler and local backups
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=30
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION=30
MAX_JOB_ATTEMPTS=4
JOB_RUN_TIMEOUT_MINUTES=15
